     return false;
   Datatype *parent = ((TypePointer *)ct)->getPtrTo();
+  if (parent->getSize() == 0)	// An incomplete structure has no layout to split by (decompiler-js patch)
+    return false;
   type_metatype meta = parent->getMetatype();
